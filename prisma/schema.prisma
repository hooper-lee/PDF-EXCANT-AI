generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  role          String    @default("USER") // UserRole
  plan          String    @default("FREE") // UserPlan
  pagesUsed     Int       @default(0)
  pagesLimit    Int       @default(300)
  stripeCustomerId String?
  inviteCode    String?   @unique
  invitedBy     String?
  inviteCount   Int       @default(0)
  invitePages   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  documents     Document[]
  extractionJobs ExtractionJob[]
  usageRecords  UsageRecord[]
  subscriptions Subscription[]
  orders        Order[]
  invitedUsers  User[]    @relation("UserInvites")
  inviter       User?     @relation("UserInvites", fields: [invitedBy], references: [id])
}

model Document {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  originalName  String
  fileUrl       String
  fileType      String
  fileSize      Int
  pageCount     Int
  
  status        String    @default("PENDING") // DocumentStatus
  extractedData String?
  outputUrl     String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  extractionJobs ExtractionJob[]
  usageRecords  UsageRecord[]
  
  @@index([userId])
}

model ExtractionTemplate {
  id            String          @id @default(cuid())
  name          String          @unique
  description   String?
  schemaJson    String?
  promptText    String
  isPublic      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  extractionJobs ExtractionJob[]

  @@index([isPublic])
  @@index([createdAt])
}

model LlmConfig {
  id         String   @id @default(cuid())
  key        String   @unique @default("default")
  provider   String   @default("OPENAI") // LlmProvider
  model      String   @default("gpt-4o-mini")
  apiKey     String?
  baseUrl    String?
  isEnabled  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isEnabled])
}

model UsageRecord {
  id         String   @id @default(cuid())
  userId     String
  source     String   // UsageSource
  direction  String   // UsageDirection
  pages      Int
  documentId String?
  note       String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([documentId])
  @@index([source])
  @@index([createdAt])
}

model ExtractionJob {
  id           String   @id @default(cuid())
  userId       String
  documentId   String
  templateId   String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  template     ExtractionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  status       String   @default("PENDING") // JobStatus
  inputPrompt  String?
  rawText      String?
  ocrText      String?
  resultJson   String?
  errorMessage String?
  lastStep     String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([documentId])
  @@index([status])
  @@index([createdAt])
}

model Subscription {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  stripeSubscriptionId String? @unique
  stripePriceId     String?
  status            String // SubscriptionStatus
  currentPeriodEnd  DateTime
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([userId])
}

model Order {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  planId        String   // UserPlan
  planName      String
  amount        Float
  currency      String   @default("USD")
  status        String   @default("PENDING") // OrderStatus
  
  // 支付信息
  paymentMethod String?  // PaymentMethod
  cardLast4     String?
  cardBrand     String?
  
  // 订单详情
  billingEmail  String
  billingName   String?
  billingCountry String?
  
  // 时间戳
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  completedAt   DateTime?
  
  @@index([userId])
  @@index([status])
}
