# Database (默认 SQLite；若使用 PostgreSQL 请修改 prisma/schema.prisma 的 provider 并改用 postgresql://...)
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="your-secret-key-change-in-production"

# AI API Keys
# 当前真实主链路使用 OPENAI_API_KEY；GEMINI_API_KEY 仅为预留配置
OPENAI_API_KEY="sk-your-openai-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# Stripe（当前仓库未安装或调用 Stripe SDK，以下变量仅为后续接入预留）
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"

# AWS S3 / Cloudflare R2 (当前未接入上传持久化，仅预留)
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="pdf-extract-files"

# Seed admin user (用于 npm run db:seed)
ADMIN_EMAIL="admin@example.com"
ADMIN_INITIAL_PASSWORD="admin"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
